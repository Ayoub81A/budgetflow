<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bottom_sheet_bg"
        android:padding="24dp">

        <!-- Handle bar -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@color/purple_light"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp" />

        <!-- Title -->
        <TextView
            android:text="Add Transaction"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" />

        <!-- Income / Expense Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="@drawable/pill_toggle_bg"
            android:padding="4dp"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btn_expense"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Expense"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/expense_red"
                app:cornerRadius="10dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

            <Button
                android:id="@+id/btn_income"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Income"
                android:textColor="@color/text_secondary"
                android:backgroundTint="@color/bg_dark"
                app:cornerRadius="10dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

        </LinearLayout>

        <!-- Amount Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Amount"
            android:layout_marginBottom="16dp"
            style="@style/DarkInputLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:inputType="numberDecimal"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Title Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Title"
            android:layout_marginBottom="16dp"
            style="@style/DarkInputLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Fixed height wrapper - same for both tabs -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="16dp">

            <!-- Category Container (Expense) -->
            <LinearLayout
                android:id="@+id/category_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="visible">

                <HorizontalScrollView
                    android:id="@+id/category_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/category_row"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Food -->
                        <LinearLayout
                            android:id="@+id/cat_food"
                            android:layout_width="64dp"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginEnd="8dp">

                                <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_food"
                                android:background="@drawable/circle_bg"
                                android:backgroundTint="@color/bg_dark"
                                android:padding="6dp"
                                android:tint="@color/text_secondary" />

                            <TextView
                                android:text="Food"
                                android:textColor="@color/text_secondary"
                                android:textSize="9sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Transport -->
                        <LinearLayout
                            android:id="@+id/cat_transport"
                            android:layout_width="64dp"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginEnd="8dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_transport"
                                android:background="@drawable/circle_bg"
                                android:backgroundTint="@color/bg_dark"
                                android:padding="6dp"
                                android:tint="@color/text_secondary" />

                            <TextView
                                android:text="Transport"
                                android:textColor="@color/text_secondary"
                                android:textSize="9sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Shopping -->
                        <LinearLayout
                            android:id="@+id/cat_shopping"
                            android:layout_width="64dp"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginEnd="8dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_shopping"
                                android:background="@drawable/circle_bg"
                                android:backgroundTint="@color/bg_dark"
                                android:padding="6dp"
                                android:tint="@color/text_secondary" />

                            <TextView
                                android:text="Shopping"
                                android:textColor="@color/text_secondary"
                                android:textSize="9sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Health -->
                        <LinearLayout
                            android:id="@+id/cat_health"
                            android:layout_width="64dp"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginEnd="8dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_health"
                                android:background="@drawable/circle_bg"
                                android:backgroundTint="@color/bg_dark"
                                android:padding="6dp"
                                android:tint="@color/text_secondary" />

                            <TextView
                                android:text="Health"
                                android:textColor="@color/text_secondary"
                                android:textSize="9sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Entertainment -->
                        <LinearLayout
                            android:id="@+id/cat_entertainment"
                            android:layout_width="64dp"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_entertainment"
                                android:background="@drawable/circle_bg"
                                android:backgroundTint="@color/bg_dark"
                                android:padding="6dp"
                                android:tint="@color/text_secondary" />

                            <TextView
                                android:text="Fun"
                                android:textColor="@color/text_secondary"
                                android:textSize="9sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Income Source Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_source"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Source"
                android:visibility="gone"
                style="@style/DarkInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />

            </com.google.android.material.textfield.TextInputLayout>

        </FrameLayout>

        <!-- Date Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Date"
            android:layout_marginBottom="24dp"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_calendar"
            style="@style/DarkInputLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:cursorVisible="false"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Wallet Selector -->
        <TextView
            android:id="@+id/tv_selected_wallet"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Select Wallet"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_input_bg" />

        <!-- Recurring Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:text="Recurring"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_recurring"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Interval Selector - hidden by default -->
        <LinearLayout
            android:id="@+id/layout_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <Button
                android:id="@+id/interval_daily"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Daily"
                android:textSize="11sp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/bg_dark"
                android:textColor="@color/text_secondary"
                style="@style/Widget.MaterialComponents.Button" />

            <Button
                android:id="@+id/interval_weekly"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Weekly"
                android:textSize="11sp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/bg_dark"
                android:textColor="@color/text_secondary"
                style="@style/Widget.MaterialComponents.Button" />

            <Button
                android:id="@+id/interval_monthly"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Monthly"
                android:textSize="11sp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/bg_dark"
                android:textColor="@color/text_secondary"
                style="@style/Widget.MaterialComponents.Button" />

            <Button
                android:id="@+id/interval_yearly"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Yearly"
                android:textSize="11sp"
                android:backgroundTint="@color/bg_dark"
                android:textColor="@color/text_secondary"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>

        <!-- Save Button -->
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/purple_main"
            android:textColor="@android:color/white"
            style="@style/Widget.MaterialComponents.Button" />

    </LinearLayout>
</ScrollView>
