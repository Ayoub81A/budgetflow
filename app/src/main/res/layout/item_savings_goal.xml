<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="@color/card_dark"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/iv_goal_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_savings"
                android:background="@drawable/circle_bg"
                android:backgroundTint="@color/purple_main"
                android:padding="6dp"
                app:tint="@android:color/white"/>

            <TextView
                android:id="@+id/tv_goal_percent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0%"
                android:textColor="@color/income_green"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_goal_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Goal Title"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="4dp"/>

        <ProgressBar
            android:id="@+id/pb_goal"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:progressDrawable="@drawable/budget_progress_bar"
            android:max="100"
            android:progress="0"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tv_goal_amount_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="$0 / $0"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
