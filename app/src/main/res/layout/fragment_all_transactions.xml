<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="@drawable/circle_bg"
            android:backgroundTint="@color/card_dark"
            android:padding="10dp"
            app:tint="@color/text_primary"
            android:layout_marginEnd="16dp"/>

        <TextView
            android:text="All Transactions"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/btn_filter_dialog"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_filter"
                android:background="@drawable/circle_bg"
                android:backgroundTint="@color/card_dark"
                android:padding="10dp"
                app:tint="@color/text_primary"/>

            <View
                android:id="@+id/view_filter_active_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:background="@drawable/circle_bg"
                android:backgroundTint="@color/purple_main"
                android:visibility="gone"/>
        </FrameLayout>

    </LinearLayout>

    <!-- Search Bar -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:hint="Search title, category, date, amount..."
        app:endIconMode="clear_text"
        style="@style/DarkInputLayout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Quick Type Filter Buttons & Filter Trigger -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:id="@+id/layout_quick_type_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/filter_all"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="All"
                android:textSize="12sp"
                android:backgroundTint="@color/purple_main"
                android:textColor="@android:color/white"
                android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.Button"/>

            <Button
                android:id="@+id/filter_expense"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Expenses"
                android:textSize="12sp"
                android:backgroundTint="@color/card_dark"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.Button"/>

            <Button
                android:id="@+id/filter_income"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Income"
                android:textSize="12sp"
                android:backgroundTint="@color/card_dark"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.Button"/>

            <Button
                android:id="@+id/filter_transfer"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Transfers"
                android:textSize="12sp"
                android:backgroundTint="@color/card_dark"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.Button"/>

            <Button
                android:id="@+id/btn_quick_filter_more"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="+ More Filters"
                android:textSize="12sp"
                android:backgroundTint="@color/input_bg"
                android:textColor="@color/purple_light"
                style="@style/Widget.MaterialComponents.Button"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Active Filter Summary Chips Row -->
    <HorizontalScrollView
        android:id="@+id/scroll_active_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layout_active_filter_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <!-- Results count -->
    <TextView
        android:id="@+id/tv_results_count"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"/>

    <!-- Transactions List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_all_transactions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false"/>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/empty_filter_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="40dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_wallet"
            app:tint="@color/text_secondary"
            android:alpha="0.4"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:text="No transactions found"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:text="Try adjusting your search query or filter"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

</LinearLayout>