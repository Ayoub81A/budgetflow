<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="@drawable/circle_bg"
            android:backgroundTint="@color/card_dark"
            android:padding="10dp"
            android:tint="@color/text_primary"
            android:layout_marginEnd="16dp"/>

        <TextView
            android:text="All Transactions"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

    </LinearLayout>

    <!-- Search Bar -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:hint="Search transactions..."
        style="@style/DarkInputLayout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Filter Row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/filter_all"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="All"
                android:textSize="12sp"
                android:backgroundTint="@color/purple_main"
                android:textColor="@android:color/white"
                android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.Button"/>

            <Button
                android:id="@+id/filter_expense"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Expenses"
                android:textSize="12sp"
                android:backgroundTint="@color/card_dark"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.Button"/>

            <Button
                android:id="@+id/filter_income"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Income"
                android:textSize="12sp"
                android:backgroundTint="@color/card_dark"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.Button"/>

            <Button
                android:id="@+id/filter_food"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Food"
                android:textSize="12sp"
                android:backgroundTint="@color/card_dark"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.Button"/>

            <Button
                android:id="@+id/filter_transport"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Transport"
                android:textSize="12sp"
                android:backgroundTint="@color/card_dark"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.Button"/>

            <Button
                android:id="@+id/filter_shopping"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Shopping"
                android:textSize="12sp"
                android:backgroundTint="@color/card_dark"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.Button"/>

            <Button
                android:id="@+id/filter_health"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Health"
                android:textSize="12sp"
                android:backgroundTint="@color/card_dark"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.Button"/>

            <Button
                android:id="@+id/filter_entertainment"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Fun"
                android:textSize="12sp"
                android:backgroundTint="@color/card_dark"
                android:textColor="@color/text_secondary"
                style="@style/Widget.MaterialComponents.Button"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Results count -->
    <TextView
        android:id="@+id/tv_results_count"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"/>

    <!-- Transactions List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_all_transactions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false"/>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/empty_filter_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="40dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_wallet"
            android:tint="@color/text_secondary"
            android:alpha="0.4"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:text="No transactions found"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:text="Try adjusting your search query or filter"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

</LinearLayout>